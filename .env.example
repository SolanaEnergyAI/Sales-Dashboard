# ---- Solana Energy Sales Dashboard ----

# Monday.com API token (Admin > API, or a service account token).
# Needs read access to the Virtual Call Centre, Sales Funnel and
# Installations In Progress boards.
MONDAY_API_TOKEN=your_monday_api_token_here

# Port the backend API + dashboard are served on
PORT=4000

# How often (seconds) the backend re-pulls all board data into cache
REFRESH_INTERVAL_SECONDS=300

# Timezone used for all timeframe boundaries (Today / This Week / etc.)
DASHBOARD_TIMEZONE=Australia/Sydney

# Default monthly team targets (also editable per-browser in the UI)
TARGET_SOLD_MONTHLY=20
TARGET_REVENUE_MONTHLY=400000
